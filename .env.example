# Copy to .env and fill in. Never commit .env (it is gitignored).
# The demo needs none of this: npm run demo reads the cached LLM output in data/llm-cache/.

# --- LLM: Groq (groq.com), OpenAI-compatible API ---
# Key from https://console.groq.com/keys
GROQ_API_KEY=
# Model used for extraction (server/extract) and for parsing crew questions (server/query).
GROQ_MODEL=openai/gpt-oss-120b

# 0 = demo mode: read the caches only (default, no network).
# 1 = call Groq live and write new cache entries.
LIVE_LLM=0

# --- Server ---
# Site server port. The web dev server proxies /api to it.
PORT=8787

# --- Web dev server (only to run a second copy beside the demo) ---
# API_PORT=8787
# WEB_PORT=5173

# --- Learning store (server/learning) ---
# Unset (default): corrections live in memory; every npm run demo starts clean.
# Set: corrections are loaded from this JSON file at startup and written after every change,
# so a server restart mid-demo keeps run-2 learning. A relative path is from the repo root.
# POST /api/reset {"keepLearning":false} also deletes the file.
# LEARNING_FILE=.learning/store.json

# --- MCP server (mcp/) ---
# Where the MCP server finds the site API.
SITE_API=http://127.0.0.1:8787
