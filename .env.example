# Copy to .env. Never commit .env.

# 0 = demo mode: extraction reads data/llm-cache/ only (default).
# 1 = call the LLM live and fill the cache.
LIVE_LLM=0

# Key for the extraction model. B picks the provider; keep only the one used.
ANTHROPIC_API_KEY=

# Server port. The web dev server proxies /api to it.
PORT=8787
