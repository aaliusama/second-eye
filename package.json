{
  "name": "site-rehearsal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "contracts",
    "server",
    "eval",
    "web",
    "mcp"
  ],
  "scripts": {
    "demo:live": "node scripts/demo-live.mjs",
    "eval:paraphrase": "tsx eval/paraphrase.ts",
    "eval:challenge": "tsx eval/challenge.ts",
    "demo": "concurrently -k -n server,web -c blue,magenta \"npm run start -w @site/server\" \"npm run dev -w @site/web\"",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @site/server\" \"npm run dev -w @site/web\"",
    "test": "vitest run",
    "eval": "npm run eval -w @site/eval",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "cache-id": "tsx server/api/cache-id.ts",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
